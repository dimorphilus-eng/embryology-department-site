# Password for /admin. Required when the site runs with `npm start` or in production.
# `npm run dev` falls back to the password embryology when this variable is empty.
ADMIN_PASSWORD=

# Public site address, no trailing slash. Used for canonical URLs, the sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to false while the sample content is still in place.
SITE_INDEXABLE=false
